{
  "base": "cuda12.1 + python3.10.14",
  "system_pkgs": ["git"],
  "pip_phases": [
    ["torch==2.4.1+cu121"],
    ["transformers==4.37.0"]
  ],
  "env": {
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "run_commands": [],
  "weight_dirs": {
    "llava-v1.5-7b": {
      "path": "/workspace/download_models/llava-v1.5-7b",
      "source": "local Hugging Face checkpoint",
      "gated": false
    }
  },
  "smoke": {
    "import_names": ["torch", "transformers"],
    "gpu_tests": [
      {
        "cmd": "/workspace/miniconda3/envs/vista/bin/python -c 'import torch; torch.manual_seed(0); x=torch.randn(8,8,device=\"cuda\"); y=x@x; print(\"WITNESS\", tuple(y.shape), torch.cuda.get_device_name(0), float(y[0,0]))'",
        "expect": "^WITNESS \\(8, 8\\) NVIDIA GeForce RTX 4090"
      }
    ],
    "cli_checks": ["nvidia-smi"]
  }
}
